#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer In { uint a[]; };
layout(set = 0, binding = 1) writeonly buffer Out { uint b[]; };
layout(push_constant) uniform Push { uint mul; };

void main()
{
   uint i = gl_GlobalInvocationID.x;
   b[i] = a[i] * mul + i;
}
